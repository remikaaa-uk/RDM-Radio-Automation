<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RDM.UI</RootNamespace>
    <AssemblyName>RDM</AssemblyName>
    <ApplicationIcon>Assets\rdm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\rdm.ico" />
  </ItemGroup>

  <!--
    FrameworkReference required to use WebApplication / Kestrel in a non-Web SDK project.
    Will be activated in UI-001E when ApiClientService embeds the HTTP server.
    Included now so the csproj does not need touching later.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"                    Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"            Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent"      Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid"  Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm"       Version="8.4.0"  />
    <!-- Pin transitive dependency (via Avalonia.FreeDesktop) to patched version.
         0.20.0 has a high-severity advisory: GHSA-xrw6-gwf8-vvr9. -->
    <PackageReference Include="Tmds.DBus.Protocol"          Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDM.Core\RDM.Core.csproj" />
    <ProjectReference Include="..\RDM.Shared\RDM.Shared.csproj" />
    <ProjectReference Include="..\RDM.Infrastructure\RDM.Infrastructure.csproj" />
    <ProjectReference Include="..\RDM.Audio\RDM.Audio.csproj" />
    <ProjectReference Include="..\RDM.API\RDM.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="rdm.config.json" CopyToOutputDirectory="Always" />
    <None Update="hotkeys.json"    CopyToOutputDirectory="Always" />
    <None Update="theme.json"      CopyToOutputDirectory="Always" />
    <None Update="lang\*.json"     CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
