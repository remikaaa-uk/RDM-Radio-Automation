<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:RDM.UI.Localization"
        x:Class="RDM.UI.Views.DatabaseSetupWindow"
        Title="{i18n:Tr db.title}"
        Icon="avares://RDM/Assets/rdm.ico"
        Width="480" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <DockPanel Margin="24">

        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{i18n:Tr db.header}"
                   FontSize="17" FontWeight="SemiBold"
                   Margin="0 0 0 20" />

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0 16 0 0">

            <Button Content="{i18n:Tr db.test}"
                    Command="{Binding TestConnectionCommand}"
                    MinWidth="140" />

            <Button Content="{i18n:Tr common.close}"
                    Command="{Binding DismissCommand}"
                    MinWidth="80" />

        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#1A1A2E"
                CornerRadius="4"
                Padding="10 8"
                Margin="0 16 0 0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="●"
                           Foreground="{Binding StatusBrush}"
                           VerticalAlignment="Center"
                           FontSize="14" />
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!-- Server -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{i18n:Tr db.server}"
                       VerticalAlignment="Center"
                       Margin="0 0 0 10" />
            <TextBox   Grid.Row="0" Grid.Column="1"
                       Text="{Binding Server}"
                       Watermark="{i18n:Tr db.server_wm}"
                       Margin="0 0 0 10" />

            <!-- Port -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Port:"
                       VerticalAlignment="Center"
                       Margin="0 0 0 10" />
            <TextBox   Grid.Row="1" Grid.Column="1"
                       Text="{Binding Port}"
                       Watermark="3306"
                       Margin="0 0 0 10" />

            <!-- User -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{i18n:Tr db.user}"
                       VerticalAlignment="Center"
                       Margin="0 0 0 10" />
            <TextBox   Grid.Row="2" Grid.Column="1"
                       Text="{Binding User}"
                       Watermark="{i18n:Tr db.user_wm}"
                       Margin="0 0 0 10" />

            <!-- Password -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{i18n:Tr db.password}"
                       VerticalAlignment="Center"
                       Margin="0 0 0 10" />
            <TextBox   Grid.Row="3" Grid.Column="1"
                       Text="{Binding Password}"
                       PasswordChar="●"
                       Margin="0 0 0 10" />

            <!-- Database name -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="{i18n:Tr db.dbname}"
                       VerticalAlignment="Center" />
            <TextBox   Grid.Row="4" Grid.Column="1"
                       Text="{Binding DatabaseName}"
                       Watermark="rdm" />

        </Grid>

    </DockPanel>

</Window>
