<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:RDM.UI.Localization"
        x:Class="RDM.UI.Views.MacroStepEditorDialog"
        Icon="avares://RDM/Assets/rdm.ico"
        Title="{i18n:Tr hw.ed.title_macro}"
        Width="460" Height="360"
        MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F0F1A">

    <Window.Styles>
        <Style Selector="TextBlock">  <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="TextBox">    <Setter Property="Background" Value="#0A0A15"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="BorderBrush" Value="#2A2A3E"/> <Setter Property="Padding" Value="5,3"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="ComboBox">   <Setter Property="Background" Value="#0A0A15"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="BorderBrush" Value="#2A2A3E"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="Button">     <Setter Property="Background" Value="#1C1C2E"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="Padding" Value="12,5"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter"> <Setter Property="Background" Value="#2A2A40"/> </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="16">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" VerticalAlignment="Top">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Tr hw.ed.order}"         VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Name="OrderBox"            Margin="0,0,0,8" Watermark="{i18n:Tr hw.ed.order_wm}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Tr hw.ed.mode}"           VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" Name="ModeBox"             Margin="0,0,0,8" HorizontalAlignment="Stretch"
                       SelectionChanged="OnModeChanged">
                <ComboBoxItem Content="{i18n:Tr hw.ed.mode_action}"/>
                <ComboBoxItem Content="{i18n:Tr hw.ed.mode_output}"/>
            </ComboBox>

            <!-- Ścieżka A: akcja -->
            <TextBlock Grid.Row="2" Grid.Column="0" Name="ActionLabel"  Text="{i18n:Tr hw.ed.action}"        VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox  Grid.Row="2" Grid.Column="1" Name="ActionIdBox"   Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Name="ParamLabel"   Text="{i18n:Tr hw.ed.parameter}"     VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Name="ParamBox"      Margin="0,0,0,8" Watermark="{i18n:Tr hw.ed.optional_wm}"/>

            <!-- Ścieżka B: output -->
            <TextBlock Grid.Row="4" Grid.Column="0" Name="OutTypeLabel"  Text="{i18n:Tr hw.ed.output_type}"  VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox  Grid.Row="4" Grid.Column="1" Name="OutTypeBox"    Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="SERIAL"/>
                <ComboBoxItem Content="DR_MIXER"/>
                <ComboBoxItem Content="MIDI"/>
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Name="OutIdLabel"    Text="{i18n:Tr hw.ed.device_id}" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="5" Grid.Column="1" Name="OutIdBox"       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Name="OutCmdLabel"   Text="{i18n:Tr hw.ed.command}"      VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="6" Grid.Column="1" Name="OutCmdBox"      Margin="0,0,0,8" Watermark="{i18n:Tr hw.ed.command_wm}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{i18n:Tr hw.ed.delay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Column="1" Name="DelayBox" Watermark="0"/>
            <Button    Grid.Column="2" Content="{i18n:Tr common.cancel}" Click="OnCancel" Margin="8,0,0,0"/>
            <Button    Grid.Column="3" Content="{i18n:Tr common.save}" Click="OnSave" Background="#1E3A5F" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
