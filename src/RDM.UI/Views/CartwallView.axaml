<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RDM.UI.ViewModels"
             xmlns:controls="using:RDM.UI.Controls"
             xmlns:i18n="using:RDM.UI.Localization"
             x:Class="RDM.UI.Views.CartwallView"
             x:DataType="vm:CartwallViewModel">

    <UserControl.Styles>
        <!-- Mode button base colours — declared before .active so .active wins on same specificity -->
        <Style Selector="Button.mode-on">
            <Setter Property="Background" Value="#204020"/>
        </Style>
        <Style Selector="Button.mode-pfl">
            <Setter Property="Background" Value="#202040"/>
        </Style>
        <Style Selector="Button.mode-off">
            <Setter Property="Background" Value="#402020"/>
        </Style>
        <Style Selector="Button.active">
            <Setter Property="Background" Value="#CC2222"/>
        </Style>
        <Style Selector="Button.cart-slot">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A5A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Mode selector + add tab button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Background="#0D0D1A" Margin="0,0,0,2">

            <Button Grid.Column="0" Content="ON"
                    Command="{Binding SetModeOnCommand}"
                    Classes="mode-on"
                    Classes.active="{Binding IsOnMode}"
                    MinWidth="60" Padding="8,6"
                    Foreground="White" />

            <Button Grid.Column="1" Content="PFL"
                    Command="{Binding SetModePflCommand}"
                    Classes="mode-pfl"
                    Classes.active="{Binding IsPflMode}"
                    MinWidth="60" Padding="8,6"
                    Foreground="White" />

            <Button Grid.Column="2" Content="OFF"
                    Command="{Binding SetModeOffCommand}"
                    Classes="mode-off"
                    Classes.active="{Binding IsOffMode}"
                    MinWidth="60" Padding="8,6"
                    Foreground="White" />

            <Button Grid.Column="4" Content="+"
                    Command="{Binding CreateTabCommand}"
                    MinWidth="32" Padding="6,6"
                    Background="#1A1A2E" Foreground="#4AB5FF"
                    FontSize="16"
                    ToolTip.Tip="{i18n:Tr cartwall.tip.add_tab}" />
        </Grid>

        <!-- Row 1: Tabs -->
        <TabControl x:Name="InnerTabControl"
                    Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0D0D1A"
                    Margin="0,0,0,4">

            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CartwallTabViewModel">
                    <Panel>
                        <Panel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{i18n:Tr cartwall.tab.rename}"     Command="{Binding RenameCommand}" />
                                <MenuItem Header="{i18n:Tr cartwall.tab.move_left}"   Command="{Binding MoveLeftCommand}" />
                                <MenuItem Header="{i18n:Tr cartwall.tab.move_right}"  Command="{Binding MoveRightCommand}" />
                                <Separator />
                                <MenuItem Header="{i18n:Tr cartwall.tab.delete}"    Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Panel.ContextMenu>
                        <TextBlock Text="{Binding Name}" Padding="8,4" FontSize="11" />
                    </Panel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:CartwallTabViewModel">
                    <ItemsControl ItemsSource="{Binding Slots}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CartSlotViewModel">
                                    <Button Classes="cart-slot"
                                            Command="{Binding TriggerCommand}"
                                            Background="{Binding Background}"
                                            Width="{Binding $parent[TabControl].DataContext.SlotWidth}"
                                            Height="{Binding $parent[TabControl].DataContext.SlotHeight}"
                                            ToolTip.Tip="{Binding Duration}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{i18n:Tr cartwall.slot.assign}" Command="{Binding AssignCommand}" />
                                                <MenuItem Header="{i18n:Tr cartwall.slot.rename_label}" Command="{Binding RenameLabelCommand}" />
                                                <MenuItem Header="{i18n:Tr cartwall.slot.change_color}"    Command="{Binding ChangeColorCommand}" />
                                                <MenuItem Header="{i18n:Tr cartwall.slot.clear}"    Command="{Binding ClearCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <!-- Slot content + progress bar at bottom -->
                                        <Grid RowDefinitions="Auto,*,Auto,Auto">

                                            <!-- Slot number (top-left) -->
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding SlotNumber}"
                                                       FontSize="9" Foreground="#888899"
                                                       HorizontalAlignment="Left" />

                                            <!-- Label or "+" placeholder -->
                                            <TextBlock Grid.Row="1"
                                                       IsVisible="{Binding IsNotEmpty}"
                                                       Text="{Binding Label}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center" />
                                            <TextBlock Grid.Row="1"
                                                       IsVisible="{Binding IsEmpty}"
                                                       Text="+"
                                                       FontSize="26"
                                                       Foreground="#505090"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />

                                            <!-- Duration when idle, remaining time when playing -->
                                            <TextBlock Grid.Row="2"
                                                       IsVisible="{Binding IsNotEmpty}"
                                                       Text="{Binding TimeText}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,4" />

                                            <!-- Progress track: always visible for occupied slots;
                                                 green fill scaled from left only when playing -->
                                            <Panel Grid.Row="3"
                                                   IsVisible="{Binding IsNotEmpty}"
                                                   Height="8"
                                                   Background="#1A3A1A">
                                                <Border Background="#5CDD7A"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="{Binding IsPlaying}"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding ProgressFraction}" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Panel>

                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

        <!-- Row 2: loading indicator -->
        <TextBlock Grid.Row="2"
                   Text="{i18n:Tr cartwall.loading}"
                   IsVisible="{Binding IsBusy}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.4" FontSize="13" />

    </Grid>

</UserControl>
