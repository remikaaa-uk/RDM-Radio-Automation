<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RDM.UI.ViewModels"
             xmlns:i18n="using:RDM.UI.Localization"
             x:Class="RDM.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#0D0D1A"
                Padding="4,4,4,4"
                BorderThickness="0,0,0,1" BorderBrush="#1C1C2E">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{i18n:Tr history.title}"
                           VerticalAlignment="Center" Margin="4,0"
                           FontWeight="SemiBold" FontSize="12" />
                <Button Grid.Column="1" Content="{i18n:Tr history.refresh}"
                        Command="{Binding RefreshCommand}"
                        Padding="8,4" FontSize="11" />
            </Grid>
        </Border>

        <!-- Bottom bar: pagination + add to playlist -->
        <Border DockPanel.Dock="Bottom" Background="#0D0D1A"
                Padding="6,5"
                BorderThickness="0,1,0,0" BorderBrush="#1C1C2E">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: + button + pagination buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="3" VerticalAlignment="Center">

                    <Button Command="{Binding AddToPlaylistCommand}"
                            Width="28" Height="26" Padding="0"
                            Background="#005500" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr history.tip.add}">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White" Margin="0,-2,0,0" />
                    </Button>

                    <Rectangle Width="6" />

                    <Button Command="{Binding FirstPageCommand}"
                            Width="26" Height="26" Padding="2"
                            Background="#0D0D2A" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr library.tip.first_page}">
                        <TextBlock Text="|◀" FontSize="9" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding PreviousPageCommand}"
                            Width="26" Height="26" Padding="2"
                            Background="#0D0D2A" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr library.tip.prev_page}">
                        <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding NextPageCommand}"
                            Width="26" Height="26" Padding="2"
                            Background="#0D0D2A" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr library.tip.next_page}">
                        <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding LastPageCommand}"
                            Width="26" Height="26" Padding="2"
                            Background="#0D0D2A" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr library.tip.last_page}">
                        <TextBlock Text="▶|" FontSize="9" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                </StackPanel>

                <!-- Center: counter + loading -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{Binding PaginationText}"
                               FontSize="12" Foreground="#AAAACC"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{i18n:Tr common.loading}"
                               IsVisible="{Binding IsBusy}"
                               FontSize="11" Foreground="#4AB5FF"
                               VerticalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  AutoGenerateColumns="False"
                  RowBackground="#0F0F1A"
                  GridLinesVisibility="None"
                  Background="#0F0F1A"
                  HeadersVisibility="Column"
                  IsReadOnly="True">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{i18n:Tr history.tip.add}"
                              Command="{Binding AddToPlaylistCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#131320" />
                    <Setter Property="Foreground" Value="#6666AA" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="#1C1C2E" />
                </Style>
                <Style Selector="DataGridColumnHeader:hover">
                    <Setter Property="Background" Value="#1C1C2E" />
                    <Setter Property="Foreground" Value="#9999CC" />
                </Style>
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="#0F0F1A" />
                    <Setter Property="Foreground" Value="LightGray" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
                <Style Selector="DataGridRow:nth-child(2n)">
                    <Setter Property="Background" Value="#141420" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="LightGray" />
                </Style>
                <Style Selector="DataGridRow:selected DataGridCell">
                    <Setter Property="Background" Value="#22336688" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="{i18n:Tr history.col.time}" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <TextBlock Text="{Binding PlayedAt}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr library.col.artist}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <TextBlock Text="{Binding Artist}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr library.col.title}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr history.col.length}" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <TextBlock Text="{Binding DurationFormatted}"
                                       FontSize="11" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr history.col.type}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <TextBlock Text="{Binding SourceType}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</UserControl>
