<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDM.UI.ViewModels"
        xmlns:i18n="using:RDM.UI.Localization"
        x:Class="RDM.UI.Views.ChangePasswordDialog"
        x:DataType="vm:ChangePasswordViewModel"
        Icon="avares://RDM/Assets/rdm.ico"
        Title="{i18n:Tr chpw.title}"
        Width="360" Height="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.KeyBindings>
        <KeyBinding Gesture="Return" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>

    <DockPanel Margin="32">

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0 0 0 24">
            <TextBlock Text="{i18n:Tr chpw.title}"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         Height="2" />

            <Button Content="{i18n:Tr common.save}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsDefault="True" />

            <Button Content="{i18n:Tr common.cancel}"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

        </StackPanel>

        <StackPanel Spacing="10">

            <TextBox Text="{Binding CurrentPassword}"
                     Watermark="{i18n:Tr chpw.current}"
                     PasswordChar="●"
                     IsEnabled="{Binding !IsBusy}" />

            <TextBox Text="{Binding NewPassword}"
                     Watermark="{i18n:Tr chpw.new}"
                     PasswordChar="●"
                     IsEnabled="{Binding !IsBusy}" />

            <TextBox Text="{Binding ConfirmPassword}"
                     Watermark="{i18n:Tr chpw.confirm}"
                     PasswordChar="●"
                     IsEnabled="{Binding !IsBusy}" />

            <Border Background="#331A1A"
                    CornerRadius="4"
                    Padding="10 8"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF6B6B"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

        </StackPanel>

    </DockPanel>

</Window>
