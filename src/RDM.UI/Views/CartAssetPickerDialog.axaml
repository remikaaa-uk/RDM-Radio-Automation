<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:RDM.UI.Localization"
        xmlns:ctrl="using:RDM.UI.Controls"
        x:Class="RDM.UI.Views.CartAssetPickerDialog"
        Icon="avares://RDM/Assets/rdm.ico"
        Title="{i18n:Tr cap.title}"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="400" MinHeight="300"
        Background="#0F0F1A">

    <Window.Styles>
        <Style Selector="Button.hdr">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="4,3"/>
            <Setter Property="Foreground"                 Value="#6666AA"/>
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.hdr:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#AAAADD"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

        <!-- Row 0: text search -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBox x:Name="SearchBox"
                     Watermark="{i18n:Tr cap.search_wm}"
                     ctrl:SearchBoxBehavior.ShowClearButton="True"
                     FontSize="12"
                     Background="#131320" Foreground="White"
                     BorderBrush="#2A2A4A"
                     TextChanged="OnSearchChanged"/>
            <Button Grid.Column="1" Content="{i18n:Tr cap.search}"
                    Width="70" Height="28" FontSize="11"
                    Margin="6,0,0,0"
                    Click="OnSearch"/>
        </Grid>

        <!-- Row 1: format filter -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{i18n:Tr cap.format}"
                       FontSize="11" Foreground="#6666AA"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FormatCombo" Grid.Column="1"
                      FontSize="11"
                      Background="#131320" Foreground="White"
                      BorderBrush="#2A2A4A"
                      SelectionChanged="OnFormatChanged"/>
            <Button Grid.Column="2" Content="{i18n:Tr cap.clear}"
                    FontSize="10" Height="26"
                    Margin="6,0,0,0" Padding="8,2"
                    Click="OnClearFormat"/>
        </Grid>

        <!-- Row 2: column headers -->
        <Border Grid.Row="2" Background="#131320"
                BorderThickness="0,0,0,1" BorderBrush="#1C1C2E">
            <Grid ColumnDefinitions="*,110,60">
                <Button x:Name="BtnTitle"  Grid.Column="0" Classes="hdr"
                        Content="{i18n:Tr cap.col.title_artist}"
                        Click="OnSortTitle"/>
                <Button x:Name="BtnFormat" Grid.Column="1" Classes="hdr"
                        Content="{i18n:Tr cap.col.format}"
                        Click="OnSortFormat"/>
                <Button x:Name="BtnTime"   Grid.Column="2" Classes="hdr"
                        Content="{i18n:Tr cap.col.time}"
                        HorizontalContentAlignment="Right"
                        Click="OnSortTime"/>
            </Grid>
        </Border>

        <!-- Row 3: asset list -->
        <ListBox Grid.Row="3" x:Name="AssetList"
                 Background="#0F0F1A"
                 BorderThickness="0"
                 SelectionChanged="OnSelectionChanged"
                 DoubleTapped="OnDoubleTapped">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding"   Value="0"/>
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Margin"    Value="0"/>
                </Style>
                <Style Selector="ListBoxItem:nth-child(odd)">
                    <Setter Property="Background" Value="#0F0F1A"/>
                </Style>
                <Style Selector="ListBoxItem:nth-child(even)">
                    <Setter Property="Background" Value="#141420"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#22336688"/>
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="#161626">
                        <Grid ColumnDefinitions="*,110,60" MinHeight="30" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,2">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12" Foreground="LightGray"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="10" Foreground="#666688"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding HasArtist}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FormatDisplay}"
                                       FontSize="11" Foreground="#555577"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationDisplay}"
                                       FontSize="11" Foreground="#555577"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="4,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 4: bottom buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="11" Foreground="#555577"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="OkBtn"
                    Content="{i18n:Tr cap.assign}"
                    Width="80" Height="26" FontSize="12"
                    IsDefault="True" IsEnabled="False"
                    Click="OnOk"/>
            <Button Grid.Column="2" Content="{i18n:Tr common.cancel}"
                    Width="80" Height="26" FontSize="12"
                    Margin="8,0,0,0" IsCancel="True"
                    Click="OnCancel"/>
        </Grid>

    </Grid>
</Window>
