<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDM.UI.ViewModels"
        xmlns:i18n="using:RDM.UI.Localization"
        x:Class="RDM.UI.Views.PlaylistBrowseDialog"
        Icon="avares://RDM/Assets/rdm.ico"
        Title="{i18n:Tr pbd.title}"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="360" MinHeight="260"
        Background="#0F0F1A">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Header row matching library style -->
        <Border Grid.Row="0" Background="#131320"
                BorderThickness="0,0,0,1" BorderBrush="#1C1C2E">
            <Grid ColumnDefinitions="*,100,80" Margin="0">
                <TextBlock Grid.Column="0" Text="{i18n:Tr pbd.col_name}"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6666AA"
                           Margin="8,4"/>
                <TextBlock Grid.Column="1" Text="{i18n:Tr pbd.col_tracks}"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6666AA"
                           Margin="4,4" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{i18n:Tr pbd.col_date}"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6666AA"
                           Margin="4,4" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Playlist list -->
        <ListBox Grid.Row="1" x:Name="DbList"
                 Background="#0F0F1A"
                 BorderThickness="0"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding"   Value="0"/>
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="Margin"    Value="0"/>
                </Style>
                <Style Selector="ListBoxItem:nth-child(odd)">
                    <Setter Property="Background" Value="#0F0F1A"/>
                </Style>
                <Style Selector="ListBoxItem:nth-child(even)">
                    <Setter Property="Background" Value="#141420"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#22336688"/>
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SavedPlaylistRowViewModel">
                    <Border BorderThickness="0,0,0,1" BorderBrush="#161626">
                        <Grid ColumnDefinitions="*,100,80" MinHeight="26" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="12" Foreground="LightGray"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ItemCountText}"
                                       FontSize="11" Foreground="#555577"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayDate}"
                                       FontSize="11" Foreground="#555577"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
            <Button x:Name="BrowseFileBtn"
                    Content="{i18n:Tr pbd.browse_file}"
                    Height="26" Padding="8,0" FontSize="11"
                    Click="OnBrowseFile"/>
            <Button Grid.Column="2" x:Name="ActionBtn"
                    Width="80" Height="26" FontSize="12"
                    IsDefault="True" IsEnabled="False"
                    Click="OnAction"/>
            <Button Grid.Column="3" Content="{i18n:Tr common.cancel}"
                    Width="80" Height="26" FontSize="12"
                    Margin="8,0,0,0" IsCancel="True"
                    Click="OnCancel"/>
        </Grid>

    </Grid>
</Window>
