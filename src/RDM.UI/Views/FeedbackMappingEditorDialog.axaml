<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:RDM.UI.Localization"
        x:Class="RDM.UI.Views.FeedbackMappingEditorDialog"
        Icon="avares://RDM/Assets/rdm.ico"
        Title="{i18n:Tr hw.ed.title_feedback}"
        Width="480" Height="420"
        MinWidth="400" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F0F1A">

    <Window.Styles>
        <Style Selector="TextBlock">  <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="TextBox">    <Setter Property="Background" Value="#0A0A15"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="BorderBrush" Value="#2A2A3E"/> <Setter Property="Padding" Value="5,3"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="ComboBox">   <Setter Property="Background" Value="#0A0A15"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="BorderBrush" Value="#2A2A3E"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="Button">     <Setter Property="Background" Value="#1C1C2E"/> <Setter Property="Foreground" Value="#CCCCDD"/> <Setter Property="Padding" Value="12,5"/> <Setter Property="FontSize" Value="12"/> </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter"> <Setter Property="Background" Value="#2A2A40"/> </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="16">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" VerticalAlignment="Top">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Tr hw.ed.event}"        VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" Name="EventNameBox"        Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Player.Started"/>
                <ComboBoxItem Content="Player.Stopped"/>
                <ComboBoxItem Content="Mic.On"/>
                <ComboBoxItem Content="Mic.Off"/>
                <ComboBoxItem Content="Cart.Started"/>
                <ComboBoxItem Content="Cart.Stopped"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Tr hw.ed.output_type}"  VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" Name="DeviceTypeBox"       Margin="0,0,0,8" HorizontalAlignment="Stretch"
                       SelectionChanged="OnDeviceTypeChanged">
                <ComboBoxItem Content="MIDI"/>
                <ComboBoxItem Content="DR_MIXER"/>
                <ComboBoxItem Content="SERIAL"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:Tr hw.ed.device_id}"    VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Name="DeviceIdBox"         Margin="0,0,0,8"/>

            <!-- MIDI fields -->
            <TextBlock Grid.Row="3" Grid.Column="0" Name="ChannelLabel"  Text="{i18n:Tr hw.ed.midi_channel}"  VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Name="ChannelBox"     Margin="0,0,0,8" Watermark="1–16"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Name="NoteLabel"     Text="{i18n:Tr hw.ed.note_gpo}" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="4" Grid.Column="1" Name="NoteCodeBox"    Margin="0,0,0,8" Watermark="0–127"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Name="VelocityLabel" Text="{i18n:Tr hw.ed.velocity}"    VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="5" Grid.Column="1" Name="VelocityBox"    Margin="0,0,0,8" Watermark="0–127"/>

            <!-- Serial field -->
            <TextBlock Grid.Row="6" Grid.Column="0" Name="SerialLabel"   Text="{i18n:Tr hw.ed.serial_cmd}" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox   Grid.Row="6" Grid.Column="1" Name="SerialCmdBox"   Margin="0,0,0,8" Watermark="{i18n:Tr hw.ed.serial_cmd_wm}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="{i18n:Tr hw.active_label}"           VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox  Grid.Row="7" Grid.Column="1" Name="EnabledBox"          Foreground="#CCCCDD"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{i18n:Tr common.cancel}" Click="OnCancel"/>
            <Button Content="{i18n:Tr common.save}" Click="OnSave" Background="#1E3A5F"/>
        </StackPanel>
    </Grid>
</Window>
