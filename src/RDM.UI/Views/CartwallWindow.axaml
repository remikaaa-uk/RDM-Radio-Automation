<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RDM.UI.Views"
        xmlns:vm="using:RDM.UI.ViewModels"
        x:Class="RDM.UI.Views.CartwallWindow"
        Icon="avares://RDM/Assets/rdm.ico"
        x:DataType="vm:CartwallViewModel"
        Title="Cartwall"
        Width="900" Height="520"
        MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A15">

    <views:CartwallView />

</Window>
