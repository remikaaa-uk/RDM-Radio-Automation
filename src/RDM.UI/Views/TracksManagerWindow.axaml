<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDM.UI.ViewModels"
        xmlns:dto="using:RDM.Shared.DTOs"
        xmlns:i18n="using:RDM.UI.Localization"
        xmlns:ctrl="using:RDM.UI.Controls"
        x:Class="RDM.UI.Views.TracksManagerWindow"
        Icon="avares://RDM/Assets/rdm.ico"
        x:DataType="vm:TracksManagerViewModel"
        Title="Tracks Manager"
        Width="1440" Height="760"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="900" MinHeight="520"
        Background="#0A0A14">

    <DockPanel>

        <!-- ═══ Menu ══════════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top" Background="#111122" Foreground="LightGray">
            <MenuItem Header="{i18n:Tr tm.menu.file}">
                <MenuItem Header="{i18n:Tr tm.menu.import_file}"       Click="OnImportFileMenuClicked" />
                <MenuItem Header="{i18n:Tr tm.menu.import_folder}"     Click="OnImportFolderMenuClicked" />
                <MenuItem Header="{i18n:Tr tm.menu.update_tracks}"     Click="OnUpdateTracksMenuClicked" />
                <Separator />
                <MenuItem Header="{i18n:Tr common.close}"              Click="OnCloseClicked" />
            </MenuItem>
            <MenuItem Header="{i18n:Tr tm.menu.edit}">
                <MenuItem Header="{i18n:Tr tm.menu.select_all}"         Click="OnSelectAllClicked" />
                <MenuItem Header="{i18n:Tr tm.menu.deselect_all}"       Click="OnDeselectAllClicked" />
                <Separator />
                <MenuItem Header="{i18n:Tr tm.menu.open_editor}"
                          Command="{Binding OpenTrackEditorCommand}"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </MenuItem>
            <MenuItem Header="{i18n:Tr tm.menu.resets}">
                <MenuItem Header="{i18n:Tr tm.menu.reset_filters}"      Click="OnResetFiltersClicked" />
            </MenuItem>
            <MenuItem Header="{i18n:Tr tm.menu.tools}">
                <MenuItem Header="{i18n:Tr tm.menu.analyze_loudness}"          Command="{Binding AnalyzeCommand}" />
                <Separator />
                <MenuItem Header="{i18n:Tr tm.menu.delete_db}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnDeleteFromDbClicked"/>
                <MenuItem Header="{i18n:Tr tm.menu.delete_disk}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnDeleteFromDiskClicked"/>
                <Separator />
                <MenuItem Header="{i18n:Tr tm.menu.purge_orphans}" Command="{Binding PurgeOrphansCommand}"
                          IsEnabled="{Binding !IsBusy}" />
                <MenuItem Header="{i18n:Tr tm.menu.optimize_db}"     Command="{Binding OptimizeDatabaseCommand}"
                          IsEnabled="{Binding !IsBusy}" />
            </MenuItem>
        </Menu>

        <!-- ═══ Top filter bar ═══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#111122"
                Padding="4,4" BorderThickness="0,0,0,1" BorderBrush="#1C1C2E">
            <StackPanel Orientation="Horizontal" Spacing="4">

                <!-- Category (format) -->
                <ComboBox ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          PlaceholderText="{i18n:Tr library.filter.any_category}"
                          Width="160" FontSize="11">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:AssetFormatDto">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Subcategory -->
                <ComboBox ItemsSource="{Binding SubcategoryFilters}"
                          SelectedItem="{Binding SelectedSubcategoryFilter}"
                          PlaceholderText="{i18n:Tr library.filter.any_subcategory}"
                          Width="160" FontSize="11">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:SubcategoryDto">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Genre -->
                <ComboBox ItemsSource="{Binding GenreFilters}"
                          SelectedItem="{Binding SelectedGenre}"
                          Width="160" FontSize="11" />

                <!-- Status -->
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatus}"
                          Width="145" FontSize="11" />

                <!-- Track type -->
                <ComboBox ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding SelectedType}"
                          Width="145" FontSize="11" />

                <!-- Search -->
                <TextBox Text="{Binding SearchText}"
                         Watermark="{i18n:Tr tm.search_watermark}"
                         ctrl:SearchBoxBehavior.ShowClearButton="True"
                         Width="220" FontSize="11" />

                <Button Command="{Binding SearchCommand}"
                        Content="{i18n:Tr tm.search}" Padding="8,4" FontSize="11"
                        IsEnabled="{Binding !IsBusy}" />

            </StackPanel>
        </Border>

        <!-- ═══ Bottom toolbar ═══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#0D0D1A" Padding="6,5"
                BorderThickness="0,1,0,0" BorderBrush="#1C1C2E">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Left: PFL transport controls + status + count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{Binding PflPlayCommand}"
                            Width="52" Height="26" Padding="2"
                            Background="#116600" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr tm.tip.pfl_play}">
                        <TextBlock Text="PFL ▶" FontSize="10" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding PflStopCommand}"
                            Width="26" Height="26" Padding="2"
                            Background="#CC2200" CornerRadius="3"
                            ToolTip.Tip="{i18n:Tr tm.tip.pfl_stop}">
                        <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Text="{Binding PflTrackTitle}"
                               IsVisible="{Binding IsPflPlaying}"
                               FontSize="11" Foreground="#5DDC8A"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{i18n:Tr common.loading}"
                               IsVisible="{Binding IsBusy}"
                               FontSize="11" Foreground="#4AB5FF"
                               VerticalAlignment="Center" Margin="8,0" />
                </StackPanel>

                <!-- Import progress (center, visible during import) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{Binding IsImporting}">
                    <TextBlock FontSize="11" Foreground="#FF9800" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Import: {0} / {1}">
                                <Binding Path="ImportProgress" />
                                <Binding Path="ImportTotal" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ProgressBar Value="{Binding ImportProgress}"
                                 Maximum="{Binding ImportTotal}"
                                 Width="160" Height="8"
                                 Foreground="#FF9800" />
                </StackPanel>

                <!-- Import + Categories buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="{i18n:Tr tm.btn.import_file}"
                            Click="OnImportFileClicked"
                            IsEnabled="{Binding !IsImporting}"
                            Padding="10,4" FontSize="11" />
                    <Button Content="{i18n:Tr tm.btn.import_folder}"
                            Click="OnImportFolderClicked"
                            IsEnabled="{Binding !IsImporting}"
                            Padding="10,4" FontSize="11" />
                    <Button Content="{i18n:Tr tm.btn.update_tracks}"
                            Click="OnUpdateTracksClicked"
                            IsEnabled="{Binding !IsImporting}"
                            Padding="10,4" FontSize="11" />
                    <Button Content="{i18n:Tr tm.btn.categories}"
                            Click="OnCategoriesClicked"
                            Padding="10,4" FontSize="11" />
                </StackPanel>

                <!-- Pagination + Close -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                    <Button Content="◀"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            Padding="8,4" FontSize="11"
                            ToolTip.Tip="{i18n:Tr library.tip.prev_page}" />
                    <TextBlock Text="{Binding PaginationText}"
                               FontSize="11" Foreground="#AAAACC"
                               VerticalAlignment="Center" Margin="4,0" />
                    <Button Content="▶"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            Padding="8,4" FontSize="11"
                            ToolTip.Tip="{i18n:Tr library.tip.next_page}" />
                    <Button Content="{i18n:Tr common.close}"
                            Click="OnCloseClicked"
                            Padding="10,4" FontSize="11" Margin="8,0,0,0" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ═══ Status bar ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#0D0D1A" Padding="6,2"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="10" Foreground="#8888AA" />
        </Border>

        <!-- ═══ Main area: left panel + data grid ════════════════════════════ -->
        <Grid ColumnDefinitions="220,5,*">

            <!-- ─── Left panel ────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0"
                          Background="#0D0D1A"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="6,4" Spacing="2">

                    <!-- TRACK CATEGORY -->
                    <TextBlock Text="{i18n:Tr tm.sec.category}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,6,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding BatchFormat}"
                                  PlaceholderText="{i18n:Tr tm.select_prompt}"
                                  FontSize="11" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:AssetFormatDto">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeCategoryCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- Subcategory -->
                    <Grid ColumnDefinitions="*,60" Margin="0,2,0,0">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchSubcategoryOptions}"
                                  SelectedItem="{Binding BatchSubcategory}"
                                  PlaceholderText="{i18n:Tr library.filter.any_subcategory}"
                                  FontSize="11" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:SubcategoryDto">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeSubcategoryCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- GENRES -->
                    <TextBlock Text="{i18n:Tr tm.sec.genres}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchGenreOptions}"
                                  SelectedItem="{Binding BatchGenre}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeGenreCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- FILE TYPES -->
                    <TextBlock Text="{i18n:Tr tm.sec.file_types}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchAssetTypeOptions}"
                                  SelectedItem="{Binding BatchAssetType}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeAssetTypeCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- TRACK STATE -->
                    <TextBlock Text="{i18n:Tr tm.sec.state}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchStatusOptions}"
                                  SelectedItem="{Binding BatchStatus}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeStatusCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- MOOD -->
                    <TextBlock Text="{i18n:Tr tm.sec.mood}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchMoodOptions}"
                                  SelectedItem="{Binding BatchMood}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeMoodCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- GENDER -->
                    <TextBlock Text="{i18n:Tr tm.sec.gender}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchGenderOptions}"
                                  SelectedItem="{Binding BatchGender}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeGenderCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- LANGUAGE -->
                    <TextBlock Text="{i18n:Tr tm.sec.language}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchLanguageOptions}"
                                  SelectedItem="{Binding BatchLanguage}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeLanguageCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- RATING -->
                    <TextBlock Text="{i18n:Tr tm.sec.rating}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BatchRatingOptions}"
                                  SelectedItem="{Binding BatchRating}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeRatingCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- START-END DATE -->
                    <TextBlock Text="{i18n:Tr tm.sec.date}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                            <TextBlock Text="{i18n:Tr tm.date.start}" FontSize="10" Foreground="#888899"
                                       VerticalAlignment="Center" Width="30" />
                            <CalendarDatePicker SelectedDate="{Binding BatchStartDate}"
                                                FontSize="10" Width="135" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                            <TextBlock Text="{i18n:Tr tm.date.end}" FontSize="10" Foreground="#888899"
                                       VerticalAlignment="Center" Width="30" />
                            <CalendarDatePicker SelectedDate="{Binding BatchEndDate}"
                                                FontSize="10" Width="135" />
                        </StackPanel>
                        <Button Grid.Row="2" Content="{i18n:Tr tm.btn.change}"
                                Command="{Binding ChangeDateCommand}"
                                FontSize="9" Padding="4,3"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <!-- TITLE OPERATIONS -->
                    <TextBlock Text="{i18n:Tr tm.sec.title_ops}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid ColumnDefinitions="*,60" Margin="0,0,0,4">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding TitleOperations}"
                                  SelectedItem="{Binding TitleOperation}"
                                  FontSize="11" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{i18n:Tr tm.btn.rename}"
                                Command="{Binding RenameCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,*,60" Margin="0,0,0,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ReplaceFrom}"
                                 Watermark="{i18n:Tr tm.find}"
                                 FontSize="10" Padding="4,3" />
                        <TextBlock Grid.Column="1"
                                   Text="→" FontSize="11"
                                   Margin="4,0" VerticalAlignment="Center"
                                   Foreground="#888899" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding ReplaceTo}"
                                 Watermark="{i18n:Tr tm.replace_with}"
                                 FontSize="10" Padding="4,3" />
                        <Button Grid.Column="3" Content="{i18n:Tr tm.btn.replace}"
                                Command="{Binding ReplaceCommand}"
                                FontSize="9" Padding="4,3" Margin="2,0,0,0" />
                    </Grid>

                    <!-- TRACK ANALYZER -->
                    <TextBlock Text="{i18n:Tr tm.sec.analyzer}" FontSize="9" Foreground="#6666AA"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,60,22" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr tm.an.start_level}"
                                       FontSize="10" Foreground="#888899" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding AnalyzerStartLevel}"
                                           Minimum="-60" Maximum="0"
                                           ShowButtonSpinner="False"
                                           FontSize="10" />
                            <TextBlock Grid.Column="2" Text="dB"
                                       FontSize="10" Foreground="#888899"
                                       VerticalAlignment="Center" Margin="3,0" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,60,22" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr tm.an.next_start}"
                                       FontSize="10" Foreground="#888899" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding AnalyzerNextStartLevel}"
                                           Minimum="-60" Maximum="0"
                                           ShowButtonSpinner="False"
                                           FontSize="10" />
                            <TextBlock Grid.Column="2" Text="dB"
                                       FontSize="10" Foreground="#888899"
                                       VerticalAlignment="Center" Margin="3,0" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,60,22" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr tm.an.end_level}"
                                       FontSize="10" Foreground="#888899" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding AnalyzerEndLevel}"
                                           Minimum="-60" Maximum="0"
                                           ShowButtonSpinner="False"
                                           FontSize="10" />
                            <TextBlock Grid.Column="2" Text="dB"
                                       FontSize="10" Foreground="#888899"
                                       VerticalAlignment="Center" Margin="3,0" />
                        </Grid>
                        <Button Grid.Row="3" Content="{i18n:Tr tm.btn.analyze}"
                                Command="{Binding AnalyzeCueCommand}"
                                FontSize="9" Padding="6,3"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <Rectangle Height="16" />

                </StackPanel>
            </ScrollViewer>

            <!-- ─── GridSplitter ──────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          Background="#1C1C2E"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ─── Data grid ─────────────────────────────────────────────── -->
            <DataGrid Grid.Column="2"
                      x:Name="TrackList"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Extended"
                      SelectionChanged="OnListSelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      Sorting="OnDataGridSorting"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="23"
                      Background="#0F0F1A"
                      RowBackground="#0F0F1A">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{i18n:Tr tm.menu.open_editor}"
                                  Command="{Binding OpenTrackEditorCommand}" />
                        <Separator />
                        <MenuItem Header="{i18n:Tr tm.ctx.set_active}"
                                  Command="{Binding ChangeStatusCommand}" />
                        <MenuItem Header="{i18n:Tr tm.ctx.set_disabled}"
                                  Command="{Binding ChangeStatusCommand}" />
                        <Separator />
                        <MenuItem Header="{i18n:Tr tm.menu.analyze_loudness}"
                                  Command="{Binding AnalyzeCommand}" />
                        <Separator />
                        <MenuItem Header="{i18n:Tr tm.menu.delete_db}"         Click="OnDeleteFromDbClicked"/>
                        <MenuItem Header="{i18n:Tr tm.menu.delete_disk}" Click="OnDeleteFromDiskClicked"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Background"                 Value="#131320" />
                        <Setter Property="Foreground"                 Value="#6666AA" />
                        <Setter Property="FontSize"                   Value="10" />
                        <Setter Property="Padding"                    Value="0,3" />
                        <Setter Property="BorderBrush"                Value="#1C1C2E" />
                        <Setter Property="BorderThickness"            Value="0,0,1,1" />
                    </Style>
                    <Style Selector="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackground}" />
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding"          Value="0" />
                        <Setter Property="BorderThickness"  Value="0" />
                    </Style>
                    <Style Selector="DataGridRow:selected /template/ Rectangle#SelectionIndicator">
                        <Setter Property="Fill" Value="Transparent" />
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="#2244AA44" />
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>

                    <!-- 1. ID -->
                    <DataGridTemplateColumn Header="ID" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding AssetId}"
                                           FontSize="10" Padding="6,0,2,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2. Typ -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.type}" Width="70" SortMemberPath="AssetType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding AssetType}"
                                           FontSize="11" Padding="2,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 3. Kategoria -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.category}" Width="100" SortMemberPath="FormatName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding FormatName}"
                                           FontSize="11" Padding="2,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#AAAACC" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 4. Artist -->
                    <DataGridTemplateColumn Header="{i18n:Tr library.col.artist}" Width="140" SortMemberPath="Artist">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="11" Padding="4,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="LightGray" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5. Title -->
                    <DataGridTemplateColumn Header="{i18n:Tr library.col.title}" Width="200" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Padding="4,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 6. Album -->
                    <DataGridTemplateColumn Header="Album" Width="150" SortMemberPath="Album">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Album}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#AAAACC" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 7. Intro -->
                    <DataGridTemplateColumn Header="Intro" Width="70" SortMemberPath="IntroMs">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Intro}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#8888AA" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 8. Duration -->
                    <DataGridTemplateColumn Header="{i18n:Tr library.col.duration}" Width="85" SortMemberPath="DurationMs">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding DurationFormatted}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#8888AA" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 9. Year -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.year}" Width="56" SortMemberPath="Year">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Year}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 10. BPM -->
                    <DataGridTemplateColumn Header="BPM" Width="60" SortMemberPath="Bpm">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding BpmFormatted}"
                                           FontSize="11" Padding="2,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 11. Gatunek -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.genre}" Width="90" SortMemberPath="Genre">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Genre}"
                                           FontSize="11" Padding="2,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 12. Podkategoria -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.subcategory}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding SubcategoryName}"
                                           FontSize="11" Padding="2,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#AAAACC" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 13. Count Played -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.play_count}" Width="108" SortMemberPath="PlayCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding PlayCount}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 14. Enabled -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.enabled}" Width="80" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding EnabledText}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 15. Mood -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.mood}" Width="100" SortMemberPath="Mood">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Mood}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 16. Gender -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.gender}" Width="80" SortMemberPath="Gender">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Gender}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 17. Language -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.language}" Width="90" SortMemberPath="Language">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Language}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 18. Rating -->
                    <DataGridTemplateColumn Header="{i18n:Tr tm.col.rating}" Width="68" SortMemberPath="Rating">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding Rating}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 19. Date Added -->
                    <DataGridTemplateColumn Header="{i18n:Tr library.col.date_added}" Width="100" SortMemberPath="CreatedAt">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TracksManagerItemViewModel">
                                <TextBlock Text="{Binding DateAdded}"
                                           FontSize="10" Padding="4,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#888899" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </DockPanel>

</Window>
